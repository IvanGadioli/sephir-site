{
  "name": "sephir-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "build": "next build && node ferramentas/podar.mjs",
    "build:sentinela": "PREFIXO=/__pfx next build && node ferramentas/podar.mjs && rm -rf out-sentinela && mv out out-sentinela",
    "verificar": "node ferramentas/verificar.mjs",
    "verificar:visual": "node ferramentas/visual.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "^4.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
